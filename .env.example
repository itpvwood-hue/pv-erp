# PVWood ERP — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file to `.env` (same directory, no extension before `.env`).
#   2. Fill in real values for any line marked "REQUIRED".
#   3. Restart the server (`start.bat` or your NSSM service).
#
# DO NOT commit `.env` to git — it contains secrets. This `.env.example` file
# is safe to commit because it has no real values.

# ──────────────────────────────────────────────────────────────────
# REQUIRED: Anthropic API key for Claude AI features
# (BOM AI Query, capacity check, daily-report generation, PDF PO parse)
# Get a key from https://console.anthropic.com/settings/keys
# Without this key, AI endpoints return 503 but the rest of the ERP works.
# ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ──────────────────────────────────────────────────────────────────
# OPTIONAL: File paths
# Leave blank/commented to use defaults relative to the project root.
# Override only if your DB / docs / logs live on a separate drive.
# Windows examples:
#   DB_PATH=D:\PVWood\erp.db
#   DOCS_DIR=D:\PVWood\docs_storage
#   FA_DIR=D:\PVWood\fa_storage      # Factory Assistant generated files (xlsx)
#   LOG_DIR=D:\PVWood\logs
# ──────────────────────────────────────────────────────────────────
# DB_PATH=
# DOCS_DIR=
# FA_DIR=
# LOG_DIR=

# ──────────────────────────────────────────────────────────────────
# OPTIONAL: Server bind address + port
#   HOST=0.0.0.0   → listens on every network interface (LAN-accessible)
#   HOST=127.0.0.1 → localhost only (server is unreachable from other machines)
#   PORT=8000      → default; change if port 8000 is taken
# ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ──────────────────────────────────────────────────────────────────
# OPTIONAL: CORS allowed origins (comma-separated, no spaces around commas)
# Default = localhost + 127.0.0.1 only. Add each LAN client that needs
# cross-origin API access, e.g.:
#   CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.50:8000
# Use "*" only in development — it disables origin checks entirely.
# ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ──────────────────────────────────────────────────────────────────
# OPTIONAL: Debug mode (enables Python traceback in 500 responses,
# more verbose logging). Leave OFF in production.
# ──────────────────────────────────────────────────────────────────
DEBUG=false
